<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Vysočina 2026 – Mlýn Vikinek" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Vysočina 2026 – místa v okolí Mlýna Vikinek</name><desc>Všechna místa z průvodce jako body pro navigaci</desc></metadata>
<wpt lat="49.644270" lon="15.968440"><name>Mlýn Vikinek</name><desc>Naše základna: historický vodní mlýn pod hrází Mlynářova rybníka.</desc></wpt>
<wpt lat="49.651780" lon="15.949450"><name>Tisůvka (804 m)</name><desc>Nejbližší skály: 58 m dlouhá rulová hradba, až 15 m vysoká, skoro za humny.</desc></wpt>
<wpt lat="49.670730" lon="16.032240"><name>Devět skal (836 m)</name><desc>Nejvyšší vrchol Žďárských vrchů: skalní labyrint a vyhlídka se zábradlím.</desc></wpt>
<wpt lat="49.661800" lon="16.038170"><name>Lisovská skála (802 m)</name><desc>Zalesněný skalní vrchol na hřebenovce kousek od Devíti skal.</desc></wpt>
<wpt lat="49.661030" lon="16.071390"><name>Malinská skála (813 m)</name><desc>Kruh až 20 m vysokých skal, jeden z nejhezčích výhledů a malá puklinová jeskyňka.</desc></wpt>
<wpt lat="49.654750" lon="16.084040"><name>Drátník (Drátenická skála, 776 m)</name><desc>200 m dlouhá skalní hradba s věží Sokol (35 m), kde trénují horolezci.</desc></wpt>
<wpt lat="49.686050" lon="16.093360"><name>Čtyři palice</name><desc>Rozeklané skalní věže nad Milovy s vyhlídkou a naučnou stezkou.</desc></wpt>
<wpt lat="49.693600" lon="16.087940"><name>Milovské perničky</name><desc>Skály s „perníkovými formičkami“, skalními mísami vymletými vodou a mrazem.</desc></wpt>
<wpt lat="49.708940" lon="16.073670"><name>Zkamenělý zámek</name><desc>Obří rulová skaliska u Svratky, kde bývalo pravěké hradiště.</desc></wpt>
<wpt lat="49.615560" lon="16.081480"><name>Pasecká skála (823 m)</name><desc>Vyhlídka se zábradlím: za dobré viditelnosti až Sněžka a Praděd. Skalní tunýlky.</desc></wpt>
<wpt lat="49.624780" lon="16.010330"><name>Brožova a Hudecká skalka</name><desc>Tři skály až 20 m vysoké v lese nad Třemi Studněmi, bez davů.</desc></wpt>
<wpt lat="49.538540" lon="15.842600"><name>Rozhledna Rosička</name><desc>42 m vysoká rozhledna: 140 schodů na plošinu ve 24 m, mimo léto zdarma.</desc></wpt>
<wpt lat="49.714030" lon="15.712380"><name>Údolí Doubravy – Čertův stolek</name><desc>Divoký kaňon s peřejemi a obřími hrnci, skalní vyhlídka Čertův stolek a jeskyně pod ní.</desc></wpt>
<wpt lat="49.818640" lon="16.140890"><name>Toulovcovy maštale</name><desc>Pískovcové skalní městečko s úzkými roklemi, chodbami a jeskyňkami.</desc></wpt>
<wpt lat="49.376800" lon="16.758150"><name>Jeskyně Balcarka</name><desc>V sobotu 10. 10. „Škola malých jeskyňářů“ pro děti od 5 let, s diplomem!</desc></wpt>
<wpt lat="49.371140" lon="16.726190"><name>Punkevní jeskyně a propast Macocha</name><desc>Krápníky, dno propasti Macocha a plavba na lodičkách po podzemní říčce Punkvě.</desc></wpt>
<wpt lat="49.373140" lon="16.729320"><name>Propast Macocha – horní můstek</name><desc>Pohled 138 m do hloubky z vyhlídkového můstku, zdarma i bez prohlídky jeskyní.</desc></wpt>
<wpt lat="49.360540" lon="16.710050"><name>Kateřinská jeskyně</name><desc>Obří podzemní dóm a „bambusový lesík“ hůlkových krápníků. Krátká prohlídka.</desc></wpt>
<wpt lat="49.410450" lon="16.739020"><name>Sloupsko-šošůvské jeskyně</name><desc>Největší zpřístupněné jeskyně v ČR: obří dómy a propasti, krátký i dlouhý okruh.</desc></wpt>
<wpt lat="49.396930" lon="15.591360"><name>Jihlavské podzemí</name><desc>Středověké chodby pod Jihlavou se záhadnou „světélkující chodbou“.</desc></wpt>
<wpt lat="49.616040" lon="16.054490"><name>Medlov: lanový park a pohádkové stezky</name><desc>Volně přístupný lanový park, prolézačky a pohádková stezka skřítka Ostružinky.</desc></wpt>
<wpt lat="49.578840" lon="16.050750"><name>Vysočina Arena: pumptrack a dětské traily</name><desc>Jeden z největších pumptracků v Česku, dětský pumptrack a skoro 30 km singltreků.</desc></wpt>
<wpt lat="49.581600" lon="15.936650"><name>Muzeum nové generace (zámek Žďár)</name><desc>Interaktivní muzeum o 800 letech kláštera a Zelené hory. Děti dostanou tvořivé překvapení.</desc></wpt>
<wpt lat="49.563020" lon="15.942820"><name>Relaxační centrum Žďár (aquapark)</name><desc>100m tobogán, brouzdaliště s hříbkem, divoká řeka a lezecká stěna nad vodou.</desc></wpt>
<wpt lat="49.634240" lon="15.929900"><name>Sklárna U Hrocha (Škrdlovice)</name><desc>Malá sklářská huť, kde vám před očima vznikne půllitr nebo džbán.</desc></wpt>
<wpt lat="49.645610" lon="15.915990"><name>Sklárna a galerie Svoboda (Karlov)</name><desc>Sklárna prof. Jaroslava Svobody: prohlídka huti v plném provozu a galerie skla.</desc></wpt>
<wpt lat="49.566000" lon="15.938200"><name>Modelové království (Žďár)</name><desc>Modelové kolejiště na 55 m² s asi 600 metry kolejí.</desc></wpt>
<wpt lat="49.641980" lon="16.096300"><name>Dům přírody Žďárských vrchů (Krátká)</name><desc>Expozice o zdejší přírodě v historickém statku, s hledačkou pro děti.</desc></wpt>
<wpt lat="49.776320" lon="15.945940"><name>Peklo Čertovina (u Hlinska)</name><desc>Interaktivní prohlídka pekla s čerty: chodby a „jeskyně“ až 12 m pod zemí.</desc></wpt>
<wpt lat="49.589830" lon="15.931070"><name>Pilák: lanová pyramida a hřiště (Žďár)</name><desc>Rekreační areál u Pilské nádrže s lanovou pyramidou a hřišti pro malé děti.</desc></wpt>
<wpt lat="49.647270" lon="15.963470"><name>Dětské hřiště Cikháj</name><desc>Hřiště se dvěma dřevěnými čerty, asi 500 m od mlýna.</desc></wpt>
<wpt lat="49.580120" lon="15.941180"><name>Zelená hora (UNESCO)</name><desc>Santiniho hvězdicový kostel, památka UNESCO, kde se vše točí kolem čísla 5.</desc></wpt>
<wpt lat="49.583170" lon="15.937540"><name>Zámek Žďár nad Sázavou</name><desc>Bývalý cisterciácký klášter se Santiniho architekturou, barokními konírnami a galerií.</desc></wpt>
<wpt lat="49.760960" lon="15.838000"><name>Skanzen Veselý Kopec</name><desc>Vesnice jako za dědečka: roubenky, stodoly a řemesla v krajině pod Železnými horami.</desc></wpt>
<wpt lat="49.450860" lon="16.318370"><name>Hrad Pernštejn</name><desc>Jeden z nejkrásnějších moravských hradů, v říjnu otevřený jen o víkendu.</desc></wpt>
<wpt lat="49.566290" lon="15.878590"><name>Šlakhamr v Hamrech nad Sázavou</name><desc>Funkční vodní hamr: obří kovářská kladiva poháněná vodním kolem.</desc></wpt>
<wpt lat="49.643880" lon="15.999420"><name>Pramen Svratky</name><desc>Tady se rodí Svratka. Její voda doteče přes Brno a Dunaj až do Černého moře.</desc></wpt>
<wpt lat="49.671560" lon="15.937860"><name>Pramen Sázavy</name><desc>Pramen řeky, která teče do Vltavy, Labe a Severního moře.</desc></wpt>
<wpt lat="49.654390" lon="15.998900"><name>Stříbrná studánka</name><desc>Studánka na jižním svahu Žákovy hory, dlouho považovaná za pramen Svratky.</desc></wpt>
<wpt lat="49.656990" lon="15.991830"><name>Žákova hora (810 m): prales</name><desc>Národní přírodní rezervace se starým jedlo-bukovým lesem a naučnou stezkou.</desc></wpt>
<wpt lat="49.637700" lon="16.002170"><name>Fryšavský kopec: partyzánský památník</name><desc>Pomník partyzánské brigády Mistr Jan Hus s replikou partyzánského bunkru.</desc></wpt>
<wpt lat="49.631770" lon="15.909620"><name>Velké Dářko</name><desc>Moře Vysočiny: největší rybník Českomoravské vrchoviny (206 ha).</desc></wpt>
<wpt lat="49.637880" lon="15.882830"><name>NS Dářská rašeliniště</name><desc>3 km dlouhá stezka po povalových chodnících přes rašeliniště, se dvěma vyhlídkami.</desc></wpt>
<wpt lat="49.608610" lon="16.038170"><name>Rybník Sykovec</name><desc>Nejvýše položený rybník Vysočiny s písčitou pláží, u Tří Studní.</desc></wpt>
<wpt lat="49.647880" lon="15.962570"><name>Restaurace a penzion Tisůvka</name><desc>Nejbližší restaurace, 600 m od mlýna, s dětským koutkem. Ideální na první večer.</desc></wpt>
<wpt lat="49.633850" lon="15.930070"><name>Hotel a restaurace U Hrocha</name><desc>Restaurace hned vedle sklářské huti. Oběd se dá spojit s ukázkou foukání skla.</desc></wpt>
<wpt lat="49.637090" lon="15.925820"><name>Restaurace penzionu Velké Dářko</name><desc>Restaurace kousek od Velkého Dářka.</desc></wpt>
<wpt lat="49.650390" lon="16.079900"><name>Hospoda U Kolouška</name><desc>Hospůdka uprostřed luk pod skálou Dráteničky, na konci skalní hřebenovky.</desc></wpt>
<wpt lat="49.629660" lon="16.040590"><name>Stanice lyžařů Fryšava</name><desc>Nejoblíbenější podnik Žďárska podle čtenářů Deníku: poctivá česká kuchyně pod Žákovou horou.</desc></wpt>
<wpt lat="49.612480" lon="16.036320"><name>Krčma na náměstí</name><desc>Hospoda v Třech Studních, u Sykovce a Medlova.</desc></wpt>
<wpt lat="49.606410" lon="15.920060"><name>Restaurace Polnička</name><desc>Regionální kuchyně na cyklotrase do Žďáru.</desc></wpt>
<wpt lat="49.689390" lon="16.065340"><name>Hostinec Za Řekou</name><desc>Hostinec v Českých Křižánkách, pod Devíti skalami.</desc></wpt>
<wpt lat="49.363730" lon="16.708220"><name>Hotel a restaurace Skalní Mlýn</name><desc>Restaurace a informační centrum u Punkevních a Kateřinské jeskyně.</desc></wpt>
<wpt lat="49.634660" lon="16.077790"><name>Kiosek Kadov „U Staré školy“</name><desc>Gastro klenot Žďárských vrchů: moderní street food v restaurační kvalitě. Je v Gastromapě i v průvodci Gault&amp;Millau 2026.</desc></wpt>
<wpt lat="49.561620" lon="15.940480"><name>Grand restaurant Poppet</name><desc>Restaurace z Maurerova výběru v centru Žďáru: česká a středomořská kuchyně s vysokými nároky.</desc></wpt>
<wpt lat="49.561320" lon="16.075040"><name>Bistro Čtyřka (Horní Dvůr)</name><desc>Bistro v krásně opraveném domě na náměstí v Novém Městě: jídla z kamen na dřevo a suroviny z místních farem.</desc></wpt>
<wpt lat="49.580750" lon="15.935770"><name>Klášterní hospoda Táferna</name><desc>Vysočinská kuchyně v klášterní hospodě z 18. století, kousek od zámku a Zelené hory.</desc></wpt>
<wpt lat="49.587560" lon="15.929280"><name>Hostinec Tálský mlýn</name><desc>Stylový hostinec ve starém mlýně pod hrází Pilské nádrže: hovězí, jehněčí a zvěřina z okolí.</desc></wpt>
<wpt lat="49.581720" lon="15.936900"><name>Zámecká kavárna</name><desc>Kavárna v bývalém klášterním pivovaru: dobrá káva a domácí zákusky po návštěvě muzea.</desc></wpt>
<wpt lat="49.646300" lon="16.121180"><name>Cukrárna Sněžné</name><desc>Vyhlášená cukrárna s vlastní výrobou od roku 1993. Zákusky, kvůli kterým se sem jezdí zdaleka.</desc></wpt>
<wpt lat="49.654730" lon="16.099070"><name>Restaurace U Paňmámy (Statek Blatiny)</name><desc>Jediná restaurace na Žďársku s „čepicí“ průvodce Gault&amp;Millau: poctivá česká kuchyně z místních surovin.</desc></wpt>
<wpt lat="49.653790" lon="16.146740"><name>Penzion a restaurace Selský dvůr</name><desc>Hlemýždi po burgundsku z vlastního chovu a pstruzi. V Gastromapě i v průvodci Gault&amp;Millau.</desc></wpt>
<wpt lat="49.559480" lon="16.072680"><name>The Black Cup – espresso bar</name><desc>Espresso bar s výběrovou kávou v Novém Městě, v Gastromapě Lukáše Hejlíka.</desc></wpt>
<wpt lat="49.563170" lon="16.076230"><name>Kafé 133</name><desc>Kavárna v Novém Městě na Moravě z výběru Gastromapy Lukáše Hejlíka.</desc></wpt>
<wpt lat="49.557450" lon="16.061920"><name>Zookoutek Nové Město na Moravě</name><desc>Lamy, klokani, nandu, poníci a oslíci u rybníčků. Soukromý zookoutek nadšence, vstup zdarma.</desc></wpt>
<wpt lat="49.751130" lon="16.152310"><name>Minifarma Falbgery</name><desc>Rodinná minifarma s asi 30 druhy zvířat: hlazení, krmení pod dozorem a svezení na poníkovi.</desc></wpt>
<wpt lat="49.620000" lon="15.954520"><name>Maso Žďársko: prodejna ve Světnově</name><desc>Maso a uzeniny z Vysočiny přímo z výrobny, 3 km od mlýna. Na grilování jako stvořené.</desc></wpt>
<wpt lat="49.690090" lon="15.991670"><name>Maso a uzeniny Z Českého Dvora</name><desc>Hovězí z Vysočiny, vepřové z vlastních chovů a uzeniny podle tradičních receptur.</desc></wpt>
<wpt lat="49.695370" lon="16.117400"><name>Sýry z Březin</name><desc>Bio sýry, jogurty a tvaroh z mléka krav, které se pasou na okolních loukách.</desc></wpt>
<wpt lat="49.746170" lon="15.876990"><name>Obora Široká mez (u Hlinska)</name><desc>Jeleni, daňci, mufloni a divočáci. Některá zvířata si nechají podrbat na hlavě.</desc></wpt>
<wpt lat="49.635360" lon="15.925960"><name>Potraviny Flop (Škrdlovice)</name><desc>Nejbližší obchod, asi 3 km od mlýna.</desc></wpt>
<wpt lat="49.691050" lon="15.991410"><name>Potraviny Lotos (Herálec)</name><desc>Smíšené zboží otevřené denně 7–22.</desc></wpt>
<wpt lat="49.555180" lon="15.936890"><name>Kaufland Žďár nad Sázavou</name><desc>Velký nákup pro 17 lidí: denně 7–22.</desc></wpt>
<wpt lat="49.554940" lon="15.937230"><name>Lékárna Benu (Žďár, u Kauflandu)</name><desc>Lékárna otevřená i o víkendu, denně 8–20.</desc></wpt>
<wpt lat="49.560520" lon="16.064130"><name>Nemocnice Nové Město na Moravě</name><desc>Nejbližší nemocnice s urgentním příjmem.</desc></wpt>
<wpt lat="49.628200" lon="15.926950"><name>Čerpací stanice Škrdlovice</name><desc>Nejbližší benzinka, denně 6–22.</desc></wpt>
<wpt lat="49.564280" lon="15.939180"><name>Turistické informační centrum Žďár</name><desc>Mapy, tipy a aktuální akce v okolí.</desc></wpt>
<wpt lat="49.569230" lon="15.944200"><name>Cyklo Chlubna (servis kol, Žďár)</name><desc>Prodejna a servis kol, kdyby něco prasklo.</desc></wpt>
</gpx>
