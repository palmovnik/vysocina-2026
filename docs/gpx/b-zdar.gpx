<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Vysočina 2026 – Mlýn Vikinek" xmlns="http://www.topografix.com/GPX/1/1">
<metadata><name>Do Žďáru na zámek a Zelenou horu</name><desc>Do Žďáru přes Škrdlovice a Polničku k Piláku a zámku s Muzeem nové generace; zpět stejnou cestou.</desc></metadata>
<wpt lat="49.589830" lon="15.931070"><name>Pilák: lanová pyramida a hřiště (Žďár)</name><desc>Rekreační areál u Pilské nádrže s lanovou pyramidou a hřišti pro malé děti.</desc></wpt>
<wpt lat="49.583170" lon="15.937540"><name>Zámek Žďár nad Sázavou</name><desc>Bývalý cisterciácký klášter se Santiniho architekturou, barokními konírnami a galerií.</desc></wpt>
<wpt lat="49.581600" lon="15.936650"><name>Muzeum nové generace (zámek Žďár)</name><desc>Interaktivní muzeum o 800 letech kláštera a Zelené hory. Děti dostanou tvořivé překvapení.</desc></wpt>
<wpt lat="49.580120" lon="15.941180"><name>Zelená hora (UNESCO)</name><desc>Santiniho hvězdicový kostel, památka UNESCO, kde se vše točí kolem čísla 5.</desc></wpt>
<wpt lat="49.606410" lon="15.920060"><name>Restaurace Polnička</name><desc>Regionální kuchyně na cyklotrase do Žďáru.</desc></wpt>
